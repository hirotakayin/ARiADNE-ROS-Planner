<launch>
	<!-- The learned 3D exploration planner (ari3d_planner.py) on an evaluation course in Gazebo, flown by
	     ari3d_mission.py. Courses come from voxel_world's make_courses.py (~/mission_runs/courses/<set>/<course>);
	     floor starts only for now (the drone spawns on the floor under the course's start).
	       rosrun rl_planner ari3d_course.sh <course dir> [arg:=value ...]     (fills spawn_* from the course)
	       roslaunch rl_planner ari3d_course.launch course:=<dir> spawn_x:=.. spawn_y:=.. [spawn_z:=0.1]
	     then: rosservice call /exploration/start
	     Needs ~/.venvs/ariadne (torch, scipy, skimage; system site packages for rospy), the training code at
	     training_dir (a checkout of hirotakayin/large-scale-DRL-exploration branch 3d-learning) and voxel_world. -->
	<arg name="course"/>
	<arg name="spawn_x"/>
	<arg name="spawn_y"/>
	<arg name="spawn_z" default="0.1"/>
	<arg name="checkpoint" default="$(env HOME)/rl/ari3d_checkpoints/stage1_25d/checkpoint.pth"/>
	<arg name="leftover_m" default="20"/> <!-- LEFTOVER_M (parameter.py); 0 = off -->
	<arg name="fallback" default="false"/> <!-- greedy first hop when the policy loops (as check_env3d.py's fallback option) -->
	<arg name="max_decisions" default="300"/>
	<arg name="speed" default="1.0"/> <!-- m/s along the route -->
	<arg name="max_seconds" default="1200"/> <!-- exploring time limit, then home -->
	<arg name="lidar_pitch_deg" default="23.5"/>
	<arg name="sim_gui" default="false"/>
	<arg name="rviz" default="false"/>
	<arg name="run_dir" default="$(env HOME)/mission_runs/ari3d_runs"/>
	<arg name="python" default="$(env HOME)/.venvs/ariadne/bin/python"/>
	<arg name="training_dir" default="$(env HOME)/rl/ari3d_deploy"/>
	<arg name="voxel_world_src" default="$(env HOME)/ws_3d/src/CERLAB-UAV-Autonomy/voxel_world/src"/>

	<!-- writes <course>/world_inline.sdf now, while the launch file is read, before Gazebo starts -->
	<param name="ari3d/world_file" command="$(arg python) $(find rl_planner)/scripts/ari3d_course_world.py $(arg course)"/>

	<include file="$(find gazebo_ros)/launch/empty_world.launch">
		<arg name="paused" value="false"/>
		<arg name="world_name" value="$(arg course)/world_inline.sdf"/>
		<arg name="verbose" value="false"/>
		<arg name="use_sim_time" value="true"/>
		<arg name="gui" value="$(arg sim_gui)"/>
	</include>
	<param name="robot_description" command="xacro '$(find uav_simulator)/urdf/quadcopter_lidar.urdf' lidar_pitch_deg:=$(arg lidar_pitch_deg)"/>
	<node pkg="topic_tools" type="throttle" name="gt_pose_throttle" args="messages /CERLAB/quadcopter/pose_raw 30 /CERLAB/quadcopter/pose"/>
	<node pkg="topic_tools" type="throttle" name="gt_vel_throttle" args="messages /CERLAB/quadcopter/vel_raw 30 /CERLAB/quadcopter/vel"/>
	<node pkg="topic_tools" type="throttle" name="gt_acc_throttle" args="messages /CERLAB/quadcopter/acc_raw 30 /CERLAB/quadcopter/acc"/>
	<node pkg="topic_tools" type="throttle" name="gt_odom_throttle" args="messages /CERLAB/quadcopter/odom_raw 30 /CERLAB/quadcopter/odom"/>
	<node name="spawn_gazebo_model" pkg="gazebo_ros" type="spawn_model" respawn="false"
	      args="-urdf -param robot_description -model quadcopter -x $(arg spawn_x) -y $(arg spawn_y) -z $(arg spawn_z) -Y 0"/>
	<include file="$(find uav_simulator)/launch/setupTF.launch">
		<arg name="pose_topic" value="/CERLAB/quadcopter/pose"/>
		<arg name="lidar_pitch_deg" value="$(arg lidar_pitch_deg)"/>
	</include>

	<!-- the controller, as in autonomous_flight's ariadne_exploration.launch -->
	<remap from="/mavros/local_position/odom" to="/CERLAB/quadcopter/odom"/>
	<remap from="/mavros/local_position/pose" to="/CERLAB/quadcopter/odom"/>
	<remap from="/mavros/setpoint_raw/local" to="/CERLAB/quadcopter/cmd_acc"/>
	<rosparam file="$(find tracking_controller)/cfg/controller_param.yaml" ns="controller"/>
	<node pkg="tracking_controller" type="tracking_controller_node" name="tracking_controller_node" output="screen"/>

	<node pkg="rl_planner" type="ari3d_planner.py" name="ari3d_planner" output="screen" launch-prefix="$(arg python)">
		<param name="course" value="$(arg course)"/>
		<param name="checkpoint" value="$(arg checkpoint)"/>
		<param name="leftover_m" value="$(arg leftover_m)"/>
		<param name="fallback" value="$(arg fallback)"/>
		<param name="max_decisions" value="$(arg max_decisions)"/>
		<param name="run_dir" value="$(arg run_dir)"/>
		<param name="training_dir" value="$(arg training_dir)"/>
		<param name="voxel_world_src" value="$(arg voxel_world_src)"/>
	</node>
	<node pkg="rl_planner" type="ari3d_mission.py" name="ari3d_mission" output="screen">
		<rosparam param="home" subst_value="true">[$(arg spawn_x), $(arg spawn_y), $(arg spawn_z)]</rosparam>
		<param name="speed" value="$(arg speed)"/>
		<param name="max_seconds" value="$(arg max_seconds)"/>
	</node>

	<node if="$(arg rviz)" pkg="rviz" type="rviz" name="ari3d_rviz" args="-d $(find rl_planner)/rviz/ari3d.rviz"/>
</launch>
